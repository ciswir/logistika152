Options -Indexes

RewriteEngine On

# Принудительный HTTPS в рабочем окружении.
# Локальные адреса не перенаправляем, чтобы OpenServer продолжал работать по HTTP.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteCond %{HTTP_HOST} !\.local(:\d+)?$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Базовые security headers.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# Конфиг с настройками никогда не отдаётся из браузера (нужно, если config.php лежит рядом с сайтом).
<Files "config.php">
    Require all denied
</Files>

# Не показывать служебные/резервные файлы.
<FilesMatch "(^\.|\.bak$|\.old$|\.orig$|\.save$|\.sql$|\.log$|\.ini$|\.env$)">
    Require all denied
</FilesMatch>
